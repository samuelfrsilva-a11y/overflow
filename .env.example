# Modelo de configuracao do Overflow: somente NOMES de variaveis e exemplos ficticios.
# NUNCA coloque valores reais neste arquivo nem o renomeie para .env dentro do repositorio.
# O Overflow le variaveis de ambiente do sistema; ele NAO carrega arquivos .env sozinho.
# No PowerShell (vale so para o terminal aberto):
#   $env:OVERFLOW_AMBIENTE = "producao"
#   $env:OVERFLOW_SECRET_KEY = (python -c "import secrets; print(secrets.token_hex(32))")

# desenvolvimento (padrao) ou producao. Outro valor interrompe a execucao.
# Em producao: OVERFLOW_SECRET_KEY obrigatoria (min. 32 caracteres) e cookie de sessao so por HTTPS.
OVERFLOW_AMBIENTE=desenvolvimento

# Chave que assina o cookie de login. Deixe vazia aqui; defina no ambiente do servidor.
OVERFLOW_SECRET_KEY=

# Caminho do banco SQLite. Padrao: banco.db na raiz do projeto.
# Exemplo ficticio: C:\dados\overflow\banco.db
OVERFLOW_BANCO=

# Empresa das movimentacoes da camera e das pessoas cadastradas.
# Obrigatoria somente se o banco tiver mais de uma empresa. Exemplo: 1
OVERFLOW_ID_EMPRESA=

# Indice da webcam (0 = primeira camera).
OVERFLOW_CAMERA_FONTE=0

# Pesos do YOLO (padrao: yolo26n.pt na raiz) e pasta dos modelos ONNX de rosto (padrao: modelos\).
OVERFLOW_MODELO_DETECCAO=
OVERFLOW_MODELOS_DIR=

# Endereco do painel. Mantenha 127.0.0.1 e exponha somente por proxy/tunel HTTPS.
OVERFLOW_HOST=127.0.0.1
OVERFLOW_PORTA=5000

# Numero EXATO de proxies reversos confiaveis na frente do painel (0 a 5). 0 = ignora X-Forwarded-*.
# Exemplo: 1 atras de um unico tunel/proxy HTTPS.
OVERFLOW_PROXIES_CONFIAVEIS=0

# So em desenvolvimento: 1 forca o cookie Secure (em producao ele ja e sempre Secure).
OVERFLOW_COOKIE_SECURE=

# Usada apenas por scripts\migrar_banco.py para criar o administrador inicial (min. 8 caracteres).
# Defina so no terminal, rode a migracao e remova a variavel em seguida.
OVERFLOW_ADMIN_PASSWORD=
